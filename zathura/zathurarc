# Main config file for zathura
include "./noctaliarc"
set recolor-lightcolor          "#E4DEDB"
set recolor-darkcolor           "#2A2523"

set font                        "Lilex Nerd Font Mono 12"
set guioptions                  "hv"
set adjust-open                 "width"
set database                    "null"

set recolor                     false 
set render-loading              false 

set selection-clipboard         "clipboard"

set recolor-keephue             true

# Mappings 
map <A-c> recolor
unmap <C-r> 
