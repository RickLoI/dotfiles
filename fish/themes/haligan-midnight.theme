[dark]
# haligan (Midnight) — remapped from theme.lua's hl-group assignments
# Each fish_color_* is matched to the closest Neovim highlight group in
# theme.lua, then resolved to that group's palette color in palette.lua (Midnight).
#
# fish role          -> matched hl group          -> palette name    -> hex
# normal              Normal.fg                     text              EDEBED
# command             Function.fg                    hibiscus          83ABE9
# keyword             Keyword.fg                     lilac             BA9ADD
# quote               String.fg                      green_hellebore   78BA87
# redirection         SpecialKey.fg (Special)         calibrachoa       DFB67C
# end                 Delimiter.fg                    muted             404C5C
# error               Error/ErrorMsg.fg                azalea            ED7F90
# param               @variable.parameter.fg           petal_dust        ADA2A9
# comment             Comment.fg                       subtle            6A63A0
# operator            Operator.fg                      subtle            6A63A0
# escape              @string.escape -> Special.fg     calibrachoa       DFB67C
# autosuggestion      NonText.fg                       muted             404C5C
# cwd                 Directory.fg                     azalea            ED7F90
# user                Title.fg                         hibiscus          83ABE9
# host                Label.fg                         gladiolus         E08F74
# host_remote         DiagnosticWarn.fg                 calibrachoa       DFB67C
# cancel              Normal.fg                        text              EDEBED
# search_match bg     base                             base              1E1C30

# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal EDEBED
fish_color_command 83ABE9
fish_color_keyword BA9ADD
fish_color_quote 78BA87
fish_color_redirection DFB67C
fish_color_end 404C5C
fish_color_error ED7F90
fish_color_param ADA2A9
fish_color_comment 6A63A0
# fish_color_match --background=brblue
fish_color_selection --reverse
# fish_color_history_current --bold
fish_color_operator 6A63A0
fish_color_escape DFB67C
fish_color_autosuggestion 404C5C
fish_color_cwd ED7F90
# fish_color_cwd_root red
fish_color_user 83ABE9
fish_color_host E08F74
fish_color_host_remote DFB67C
fish_color_cancel EDEBED
fish_color_search_match --background=1E1C30
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
# progress    -> DiagnosticOk/String (green_hellebore)
# background  -> surface
# prefix      -> Label.fg (gladiolus, matched-text highlight)
# completion  -> Comment/subtle (regular candidate text)
# description -> NonText/muted (secondary text)
# selected_background -> overlay
# selected_prefix     -> Label.fg (gladiolus)
# selected_completion -> Normal/text (full-strength on selection)
# selected_description -> Normal/text
fish_pager_color_progress 78BA87
fish_pager_color_background --background=24223A
fish_pager_color_prefix E08F74
fish_pager_color_completion 6A63A0
fish_pager_color_description 404C5C
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=2A2843
fish_pager_color_selected_prefix E08F74
fish_pager_color_selected_completion EDEBED
fish_pager_color_selected_description EDEBED

# haligan palette (Midnight) — raw accessors matching palette.lua exactly
fish_color_subtle 6A63A0
fish_color_muted 404C5C
fish_color_text EDEBED
fish_color_azalea ED7F90
fish_color_gladiolus E08F74
fish_color_calibrachoa DFB67C
fish_color_green_hellebore 78BA87
fish_color_weather_glass 7FBBD8
fish_color_hibiscus 83ABE9
fish_color_lilac BA9ADD
fish_color_petal_dust ADA2A9
fish_color_base 1E1C30
fish_color_surface 24223A
fish_color_overlay 2A2843
fish_color_highlight_min 201E33
fish_color_highlight_max 39355A
