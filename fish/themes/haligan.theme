# name: 'haligan'

[light]
# haligan (Noon) — remapped from theme.lua's hl-group assignments
# Each fish_color_* is matched to the closest Neovim highlight group in
# theme.lua, then resolved to that group's palette color in palette.lua (Noon).
#
# fish role          -> matched hl group          -> palette name    -> hex
# normal              Normal.fg                     text              2A2523
# command             Function.fg                    hibiscus          4C70AC
# keyword             Keyword.fg                     lilac             8F70BC
# quote               String.fg                      green_hellebore   3D9760
# redirection         SpecialKey.fg (Special)         calibrachoa       B08A3A
# end                 Delimiter.fg                    muted             BDB4BF
# error               Error/ErrorMsg.fg                azalea            C24F68
# param               @variable.parameter.fg           petal_dust        9C7E6E
# comment             Comment.fg                       subtle            948A93
# operator            Operator.fg                      subtle            948A93
# escape              @string.escape -> Special.fg     calibrachoa       B08A3A
# autosuggestion      NonText.fg                       muted             BDB4BF
# cwd                 Directory.fg                     azalea            C24F68
# user                Title.fg                         hibiscus          4C70AC
# host                Label.fg                         gladiolus         C2794F
# host_remote         DiagnosticWarn.fg                 calibrachoa       B08A3A
# cancel              Normal.fg                        text              2A2523
# search_match bg     base                             base              E4DEDB

# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal 2A2523
fish_color_command 4C70AC
fish_color_keyword 8F70BC
fish_color_quote 3D9760
fish_color_redirection B08A3A
fish_color_end BDB4BF
fish_color_error C24F68
fish_color_param 9C7E6E
fish_color_comment 948A93
# fish_color_match --background=brblue
fish_color_selection --reverse
# fish_color_history_current --bold
fish_color_operator 948A93
fish_color_escape B08A3A
fish_color_autosuggestion BDB4BF
fish_color_cwd C24F68
# fish_color_cwd_root red
fish_color_user 4C70AC
fish_color_host C2794F
fish_color_host_remote B08A3A
fish_color_cancel 2A2523
fish_color_search_match --background=E4DEDB
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
# progress    -> DiagnosticOk/String (green_hellebore)
# background  -> surface
# prefix      -> Label.fg (gladiolus, matched-text highlight)
# completion  -> Comment/subtle (regular candidate text)
# description -> NonText/muted (secondary text)
# selected_background -> overlay
# selected_prefix     -> Label.fg (gladiolus)
# selected_completion -> Normal/text (full-strength on selection)
# selected_description -> Normal/text
fish_pager_color_progress 3D9760
fish_pager_color_background --background=D9D1CD
fish_pager_color_prefix C2794F
fish_pager_color_completion 948A93
fish_pager_color_description BDB4BF
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=CCC2BE
fish_pager_color_selected_prefix C2794F
fish_pager_color_selected_completion 2A2523
fish_pager_color_selected_description 2A2523

# haligan palette (Noon) — raw accessors matching palette.lua exactly
fish_color_subtle 948A93
fish_color_muted BDB4BF
fish_color_text 2A2523
fish_color_azalea C24F68
fish_color_gladiolus C2794F
fish_color_calibrachoa B08A3A
fish_color_green_hellebore 3D9760
fish_color_weather_glass 2E96A2
fish_color_hibiscus 4C70AC
fish_color_lilac 8F70BC
fish_color_petal_dust 9C7E6E
fish_color_base E4DEDB
fish_color_surface D9D1CD
fish_color_overlay CCC2BE
fish_color_highlight_min D2C8C3
fish_color_highlight_max B0A6B2

[dark]
